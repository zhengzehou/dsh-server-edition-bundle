{
  "name": "@dsh-server-edition/plugin-bundle",
  "version": "0.3.0",
  "description": "DSH Server Edition Local Agent First bundle with login/config UI, auth, runtime coordination and MySQL persistence.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    ".codex-plugin",
    "lib",
    "components",
    "tools",
    "scripts",
    "tests",
    "docs",
    "cordis.patch.yml",
    "bundle-manifest.json",
    "README.md",
    "locale/*.json"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node tests/all.mjs",
    "test:control-plane": "node tests/control-plane-smoke.mjs",
    "test:same-host": "node tools/verify-same-host.mjs",
    "preflight": "node tools/preflight.mjs --plan",
    "install:plan": "node tools/install.mjs --plan",
    "uninstall:plan": "node tools/uninstall.mjs --plan",
    "migration:plan": "node tools/migrate.mjs plan",
    "test:mysql": "node tests/mysql-smoke.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"],
      "platform": "web"
    }
  },
  "license": "Apache-2.0"
}
